#!/bin/bash

# origaitv:summary=Print the installed OrigaiTV and Omarchy versions
# origaitv:examples=origaitv version

set -euo pipefail

ORIGAITV_PATH=${ORIGAITV_PATH:-/usr/share/origaitv}

if [[ -f $ORIGAITV_PATH/settings ]]; then
  # shellcheck source=/dev/null
  source "$ORIGAITV_PATH/settings"
  echo "OrigaiTV ${ORIGAITV_VERSION:-unknown} (${ORIGAITV_CHANNEL:-stable})"
else
  # A checkout, not the package.
  echo "OrigaiTV dev ($(git -C "$ORIGAITV_PATH" rev-parse --short HEAD 2>/dev/null || echo unknown))"
fi

# What it runs, by the same rule as Settings, System (daemon/release.ts):
# the release the USB stick was, while the box runs the build the stick
# carried, or once an update on edge has moved it past that build, edge,
# installed from that release. Nothing more on stable, whose own version is
# the release, or on a box with no release. An edge build's version, like
# 1.0.0rc6.r12.gabc1234, is never a release, though it's named after one.
release_file=${ORIGAITV_RELEASE_FILE:-/etc/origaitv/release}
release_re='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-rc[1-9][0-9]*)?$'
if [[ -r $release_file && ! ${ORIGAITV_VERSION:-} =~ $release_re ]]; then
  release=$(sed -n '1{s/[[:space:]]//g;p;}' "$release_file")
  shipped=$(sed -n '2{s/[[:space:]]//g;p;}' "$release_file")
  if [[ $release =~ $release_re ]]; then
    if [[ -z $shipped || $shipped == "${ORIGAITV_VERSION:-}" ]]; then
      echo "Release $release"
    else
      echo "Edge channel, installed from $release"
    fi
  fi
fi

if type -P omarchy-version >/dev/null; then
  echo "Omarchy $(omarchy-version)"
fi
